# DiscoverMake R1 environment. Copy to .env.local and fill in. NEVER commit real values.
# Every variable is documented in docs/architecture/r1-implementation.md (env var table).

# --- App -------------------------------------------------------------------
# Public base URL (used in signed links, Stripe redirects, passport QR codes).
APP_URL=http://localhost:3000

# --- Database (Postgres 16; Supabase/Neon in staging + prod) ----------------
DATABASE_URL=postgresql://dm:dm@localhost:5432/discovermake

# --- Object storage --------------------------------------------------------
# local = files under STORAGE_LOCAL_DIR (dev only); s3 = any S3-compatible store
# (AWS S3, Cloudflare R2, Supabase Storage S3 endpoint, MinIO).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/storage
# HMAC key for local-driver signed URLs (required in production if STORAGE_DRIVER=local).
STORAGE_SIGNING_SECRET=replace-with-32+-random-chars
S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=discovermake-dev
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_FORCE_PATH_STYLE=true

# --- Payments ---------------------------------------------------------------
# stripe = Stripe Checkout (test or live keys). dev = local test double; refuses to run when NODE_ENV=production.
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Stripe Connect shop payouts: signing secret of the /api/webhooks/stripe-connect endpoint (listens to account.updated on connected accounts).
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_connect_replace_me
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# --- Shipping ---------------------------------------------------------------
# easypost = EasyPost labels + tracking webhooks. manual = shop enters tracking (test double; refuses in production).
CARRIER=easypost
EASYPOST_API_KEY=EZTK_replace_me
EASYPOST_WEBHOOK_SECRET=replace-me

# --- Signing + auth secrets (ADR-0008) -------------------------------------
# HMAC key for buyer order links (rotating it revokes every order link).
ORDER_LINK_SECRET=replace-with-32+-random-chars
# HMAC key for Product Passport signatures.
PASSPORT_SIGNING_SECRET=replace-with-32+-random-chars
# HMAC key for signed shop job packets.
JOB_PACKET_SIGNING_SECRET=replace-with-32+-random-chars
# Bearer token for /api/admin/* (ops). Admin API is disabled when unset.
ADMIN_TOKEN=replace-with-32+-random-chars
# Bearer secret for scheduled jobs only (offer expiry + outbox publish; see vercel.json). Vercel Cron sends it automatically.
CRON_SECRET=replace-with-32+-random-chars

# --- Email -------------------------------------------------------------------
# Optional: when unset, notifications are logged to the console.
RESEND_API_KEY=re_replace_me
EMAIL_FROM=DiscoverMake <orders@discovermake.com>
OPS_EMAIL=ops@discovermake.com

# --- Make AI intake (R2 seed, off by default) --------------------------------
# MAKE_AI_ENABLED gates POST /api/make-ai/intake (404 unless "true");
# NEXT_PUBLIC_MAKE_AI_ENABLED shows the /make/ai page (inlined at build time).
MAKE_AI_ENABLED=false
NEXT_PUBLIC_MAKE_AI_ENABLED=false
# Any Gemini model id accepted by @ai-sdk/google.
MAKE_AI_MODEL=gemini-3.5-flash
# Google AI Studio key (https://aistudio.google.com/app/apikey). Intake answers 503 when unset.
GOOGLE_GENERATIVE_AI_API_KEY=replace-me

# --- CAD worker (R2, services/cad-worker) --------------------------------------
# Base URL of the CadQuery worker (runs outside Vercel). CAD generation answers 501 when unset.
CAD_WORKER_URL=
# Must match the worker's CAD_WORKER_TOKEN.
CAD_WORKER_TOKEN=

# --- R6 Reconstruct: optional GPU worker (docs/architecture/r6-reconstruct.md) ---
# SAM 2 -> OpenCV -> COLMAP / Open3D host. Unset = no "Auto-detect"; the manual caliper path works without it.
RECONSTRUCT_WORKER_URL=
RECONSTRUCT_WORKER_TOKEN=

# --- Rate limiting (Stage 1) ---------------------------------------------------
# postgres = shared buckets in the rate_limit_buckets table (every instance counts together; default in production)
# memory   = per-instance maps (default in development and tests). Leave empty for the default.
RATE_LIMIT_STORE=

# --- Sourcing MCP server (R2, /api/mcp/sourcing) --------------------------------
# No env vars: Accio Work workspaces authenticate with per-client tokens created by
# POST /api/admin/sourcing/clients (or the Sourcing desk). Each client can be limited to some
# tools and IP ranges (its allowlist). See mcp/discovermake-sourcing/README.md.

# --- CAD evals (optional, bun run eval:cad) -------------------------------------
# Live mode runs when a provider key is set (GOOGLE_GENERATIVE_AI_API_KEY above, or the gateway).
# AI_GATEWAY_API_KEY=
# CAD_EVAL_GATEWAY_MODELS=anthropic/claude-sonnet-4.5,openai/gpt-5
# CAD_EVAL_GOOGLE_MODEL=

# --- R3 Prime: supplier-route ordering + Delivery Promise (docs/architecture/r3-prime.md) ---
# Owner inputs. Unset = the documented default.
# SUPPLIER_DEPOSIT_PCT=0.5                         # share of a supplier-route order charged at checkout
# SUPPLIER_MARGIN_PCT=0.18                         # DiscoverMake margin on the supplier landed cost
# SUPPLIER_RISK_RESERVE_PCTS=0.03,0.06,0.10,0.15   # risk reserve by tier LOW,MEDIUM,HIGH,VERY_HIGH
# SUPPLIER_PO_DEPOSIT_PCT=0.3                      # supplier deposit paid with the PO (share of landed cost)
# PROMISE_CREDIT_PCT=0.10                          # missed-promise credit, share of the order subtotal
# PROMISE_CREDIT_CAP_CENTS=25000                   # missed-promise credit cap ($250)
# Catalog distributor provider (Mouser Search API). Unset = disabled and never called.
# MOUSER_API_KEY=

# --- Accounts (R2, ADR-0009) -----------------------------------------------------
# HMAC key for email sign-in codes. Required in production (dev uses a labelled fallback).
AUTH_SECRET=replace-with-32+-random-chars
# Comma-separated emails that get the ops + admin roles when they sign in.
ADMIN_EMAILS=
# Google sign-in: shown only when both are set. Redirect URI: ${APP_URL}/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Sign in with Apple: shown only when all four are set. Return URL: ${APP_URL}/api/auth/oauth/apple/callback (https only).
# APPLE_CLIENT_ID is the Services ID; APPLE_PRIVATE_KEY is the .p8 key (PEM; literal \n escapes are fine).
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Passkeys need no keys: the relying party is the APP_URL host.

# --- DiscoverMake Live (R4, workflow 06, docs/architecture/r4-live.md) ---------
# HMAC key for server-signed Live Build Protocol events (product focus, drops, slots, orders).
# Required in production; a dev-only fallback is used elsewhere.
LIVE_EVENT_SIGNING_SECRET=replace-with-32+-random-chars
# LiveKit (Cloud or self-hosted). Leave all three empty to run Live without rooms: shows then
# play their HLS/MP4 source (Owncast, MediaMTX, a recorded replay) or a poster.
# Webhooks: point LiveKit at https://<app>/api/webhooks/livekit (signed with the same key pair).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Dev / e2e only ------------------------------------------------------------
# Deterministic Shop Console token created by `bun run db:seed` (leave empty to have one generated and printed once).
SEED_SHOP_TOKEN=

# Which proxy header carries the client IP (rate limits, MCP CIDR allowlist): vercel | real-ip | xff | none.
# Default: vercel on Vercel, else xff (the rightmost X-Forwarded-For hop added by your reverse proxy).
TRUSTED_PROXY=

# Upload malware scanning (ClamAV clamd INSTREAM). Unset = not scanned. Production: set both and UPLOAD_SCAN_REQUIRED=true.
CLAMAV_HOST=
CLAMAV_PORT=3310
UPLOAD_SCAN_REQUIRED=
