{
    "name": "discovermake",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint . --ext .ts,.tsx,.js,.mjs,.mts --max-warnings=0",
        "typecheck": "tsc --noEmit",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "bun src/server/db/cli/migrate.ts",
        "db:seed": "bun src/server/db/cli/seed.ts",
        "db:setup": "bun run db:migrate && bun run db:seed",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "playwright test",
        "load:test": "bun scripts/load/run.ts",
        "ops:restore-drill": "bash scripts/ops/restore-drill.sh",
        "eval:cad": "bun --conditions=react-server evals/cad/run.ts",
        "videos:tests": "RECORD_VIDEO=1 playwright test --grep-invert \"Mobbin page sweep\" --output videos/raw/tests",
        "videos:tours": "playwright test -c playwright.tours.config.ts",
        "videos:collect": "bun scripts/videos/collect.ts",
        "vercel-build": "bash scripts/ops/vercel-build.sh",
        "db:netlify": "bun scripts/ops/netlify-migrations.ts"
    },
    "dependencies": {
        "@ai-sdk/google": "^4.0.126",
        "@aws-sdk/client-s3": "^3.1177.0",
        "@aws-sdk/s3-request-presigner": "^3.1177.0",
        "@modelcontextprotocol/sdk": "^1.32.2",
        "@netlify/blobs": "^10.7.13",
        "@netlify/database": "^2.0.4",
        "@netlify/functions": "^6.1.2",
        "@react-three/drei": "^10.7.9",
        "@react-three/fiber": "^9.8.2",
        "@simplewebauthn/browser": "^13.3.0",
        "@simplewebauthn/server": "^13.3.3",
        "@tanstack/react-query": "^5.108.4",
        "@xyflow/react": "^12.12.1",
        "ai": "^7.0.181",
        "arctic": "^3.7.0",
        "clsx": "^2.1.1",
        "drizzle-orm": "^0.45.4",
        "dxf-parser": "^1.1.2",
        "hls.js": "^1.7.4",
        "livekit-client": "^2.25.0",
        "livekit-server-sdk": "^2.20.1",
        "lucide-react": "^0.563.0",
        "maplibre-gl": "^5.24.1",
        "next": "^16.4.6",
        "postgres": "^3.4.9",
        "qrcode": "^1.5.4",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "server-only": "^0.0.1",
        "sonner": "^2.0.8",
        "stripe": "^20.4.1",
        "tailwind-merge": "^2.6.2",
        "tailwindcss-animate": "^1.0.7",
        "three": "^0.186.1",
        "zod": "^3.25.76"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.14.1",
        "@playwright/test": "^1.65.1",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/react": "^16.3.3",
        "@types/jsdom": "^30.0.0",
        "@types/node": "^20.19.43",
        "@types/qrcode": "^1.5.6",
        "@types/react": "^19.3.1",
        "@types/react-dom": "^19.3.0",
        "@types/three": "^0.186.0",
        "autoprefixer": "^10.7.0",
        "drizzle-kit": "^0.31.11",
        "eslint": "^8.57.1",
        "eslint-config-next": "15.1.2",
        "jsdom": "^30.1.3",
        "postcss": "^8.5.33",
        "tailwindcss": "^3.4.19",
        "typescript": "^5.9.3",
        "vitest": "^5.1.1"
    }
}
