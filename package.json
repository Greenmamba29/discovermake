{
    "name": "discovermake",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint . --ext .ts,.tsx,.js,.mjs --max-warnings=0",
        "typecheck": "tsc --noEmit",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "bun src/server/db/cli/migrate.ts",
        "db:seed": "bun src/server/db/cli/seed.ts",
        "db:setup": "bun run db:migrate && bun run db:seed",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "playwright test",
        "load:test": "bun scripts/load/run.ts",
        "ops:restore-drill": "bash scripts/ops/restore-drill.sh",
        "eval:cad": "bun --conditions=react-server evals/cad/run.ts",
        "videos:tests": "RECORD_VIDEO=1 playwright test --grep-invert \"Mobbin page sweep\" --output videos/raw/tests",
        "videos:tours": "playwright test -c playwright.tours.config.ts",
        "videos:collect": "bun scripts/videos/collect.ts"
    },
    "dependencies": {
        "@ai-sdk/google": "^4.0.88",
        "@aws-sdk/client-s3": "^3.1146.0",
        "@aws-sdk/s3-request-presigner": "^3.1146.0",
        "@modelcontextprotocol/sdk": "^1.32.1",
        "@react-three/drei": "^10.7.9",
        "@react-three/fiber": "^9.8.1",
        "@simplewebauthn/browser": "13",
        "@simplewebauthn/server": "13",
        "@tanstack/react-query": "^5.104.1",
        "@xyflow/react": "^12.12.0",
        "ai": "^7.0.128",
        "arctic": "3",
        "clsx": "^2.1.1",
        "drizzle-orm": "^0.45.3",
        "dxf-parser": "^1.1.2",
        "hls.js": "1",
        "livekit-client": "2",
        "livekit-server-sdk": "2",
        "lucide-react": "^0.563.0",
        "maplibre-gl": "5",
        "next": "^16.1.6",
        "postgres": "^3.4.9",
        "qrcode": "^1.5.4",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "server-only": "^0.0.1",
        "sonner": "^2.0.7",
        "stripe": "^20.1.0",
        "tailwind-merge": "^2.6.0",
        "tailwindcss-animate": "^1.0.7",
        "three": "^0.186.1",
        "zod": "^3.24.1"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.13.0",
        "@playwright/test": "^1.58.2",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/react": "^16.3.3",
        "@types/jsdom": "^30.0.0",
        "@types/node": "^20",
        "@types/qrcode": "^1.5.6",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@types/three": "^0.186.0",
        "autoprefixer": "^10.0.1",
        "drizzle-kit": "^0.31.11",
        "eslint": "^8",
        "eslint-config-next": "15.1.2",
        "jsdom": "^30.1.2",
        "postcss": "^8",
        "tailwindcss": "^3.4.1",
        "typescript": "^5",
        "vitest": "^5.0.3"
    }
}
